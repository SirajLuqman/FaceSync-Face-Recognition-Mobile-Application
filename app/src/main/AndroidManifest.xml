<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.fyp.facesync">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.FaceSync">

        <!-- DEFAULT / LAUNCHER ACTIVITY -->
        <activity
            android:name="com.fyp.facesync.SplashActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Entry / Face Recognition -->
        <activity
            android:name="com.fyp.facesync.RecognitionActivity"
            android:exported="true" />

        <!-- Admin Authentication -->
        <activity
            android:name="com.fyp.facesync.AdminLoginActivity"
            android:exported="true" />

        <activity
            android:name="com.fyp.facesync.ForgotPasswordActivity"
            android:exported="true" />

        <activity
            android:name="com.fyp.facesync.AdminSignupActivity"
            android:exported="true" />

        <!-- Admin Dashboard -->
        <activity
            android:name="com.fyp.facesync.DashboardActivity"
            android:exported="true" />

        <!-- Dashboard Features -->
        <activity
            android:name="com.fyp.facesync.LiveMonitorActivity"
            android:exported="true" />

        <activity
            android:name="com.fyp.facesync.LogsActivity"
            android:exported="true" />

        <activity
            android:name="com.fyp.facesync.RegistrationActivity"
            android:exported="true" />

        <activity
            android:name="com.fyp.facesync.UserManagementActivity"
            android:exported="true" />

        <activity
            android:name="com.fyp.facesync.SettingsActivity"
            android:exported="true" />

    </application>

</manifest>
