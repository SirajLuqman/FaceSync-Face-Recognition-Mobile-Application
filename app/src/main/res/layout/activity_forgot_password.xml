<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/base_black"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnBackToLogin"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/accent_cyan"
            android:contentDescription="Back to Login"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset Password"
            android:textSize="28sp"
            android:textColor="@color/accent_cyan"
            android:fontFamily="@font/orbitron_bold"
            android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter your Admin credentials to verify your identity."
            android:textColor="@color/white"
            android:textSize="14sp"
            android:gravity="center"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginBottom="32dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutResetID"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Admin ID"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/text_input_stroke"
            app:hintTextColor="@color/accent_cyan"
            android:textColorHint="#7A8C99"
            app:boxBackgroundColor="@android:color/transparent"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etResetID"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:maxLength="30"
                android:maxLines="1"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutResetEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Registered Email"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/text_input_stroke"
            app:hintTextColor="@color/accent_cyan"
            android:textColorHint="#7A8C99"
            app:boxBackgroundColor="@android:color/transparent"
            android:layout_marginBottom="24dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etResetEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:inputType="textEmailAddress"
                android:maxLength="30"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerifyAndReset"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="VERIFY DETAILS"
            android:textColor="@color/base_black"
            android:fontFamily="@font/orbitron_bold"
            android:backgroundTint="@color/accent_cyan"
            app:cornerRadius="14dp"/>

        <TextView
            android:id="@+id/tvResetError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF5252"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>