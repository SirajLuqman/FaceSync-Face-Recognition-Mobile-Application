<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000F14"
    android:padding="16dp">

    <ImageButton
        android:id="@+id/btnBack"
        android:contentDescription="Go back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_arrow_back"
        app:tint="#00FFFF" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/btnBack"
        android:layout_alignBottom="@id/btnBack"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:text="User Management"
        android:textColor="#00FFFF"
        android:textSize="22sp"
        android:fontFamily="@font/orbitron_bold" />

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@id/btnBack"
        android:layout_marginTop="16dp"
        android:background="@drawable/result_card_border"
        android:hint="Search by Name or ID..."
        android:paddingLeft="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#55FFFFFF"
        android:maxLength="30"
        android:maxLines="1"/>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/etSearch"
        android:layout_marginTop="8dp"
        android:background="#000F14"
        app:tabTextColor="#55FFFFFF"
        app:tabSelectedTextColor="#00FFFF"
        app:tabIndicatorColor="#00FFFF"
        app:tabIndicatorHeight="3dp"
        app:tabTextAppearance="@style/TabTextStyle"
        android:contentDescription="User categories"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tabLayout"
        android:layout_alignParentBottom="true" />

</RelativeLayout>