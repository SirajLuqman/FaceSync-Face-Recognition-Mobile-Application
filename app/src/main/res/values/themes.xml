<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Theme.FaceSync" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/base_black</item>
        <item name="colorPrimaryVariant">@color/base_black</item>
        <item name="colorAccent">@color/accent_cyan</item>
        <item name="android:textColor">@color/white</item>
        <item name="colorControlActivated">@color/accent_cyan</item>
        <item name="colorControlNormal">@color/accent_cyan</item>
        <item name="colorControlHighlight">@color/label_grey</item>
        <item name="android:textCursorDrawable">@null</item>

        <!-- Fonts -->
        <item name="android:fontFamily">@font/poppins_medium</item>

        <!-- Window background (used during cold start, replaces launcher flash) -->
        <item name="android:windowBackground">@color/base_black</item>

        <!-- Optional: Remove window splash animation / prevent icon flash -->
        <item name="android:windowDisablePreview">true</item>
    </style>

        <style name="TabTextStyle" parent="TextAppearance.Design.Tab">
            <item name="android:fontFamily">@font/orbitron_bold</item>
            <item name="android:textSize">12sp</item>
            <item name="android:textAllCaps">true</item>
        </style>

    <style name="CustomAlertDialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/result_card_border</item>
        <item name="android:textColorPrimary">#00FFFF</item>
        <item name="android:textColorSecondary">#FFFFFF</item>
        <item name="colorAccent">#00FFFF</item>

        <item name="buttonBarPositiveButtonStyle">@style/AlertButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/AlertButtonStyle</item>
    </style>

    <style name="AlertButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">#00FFFF</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>


</resources>
